#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB    &kp Q  &kp W  &kp E     &kp R   &kp T            &kp Y    &kp U     &kp I      &kp O    &kp P     &kp LALT
                &kp LSHFT  &kp A  &kp S  &kp D     &kp F   &kp G            &kp H    &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
                &kp LCTRL  &kp Z  &kp X  &kp C     &kp V   &kp B            &kp N    &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                                         &kp LGUI  &mo 1   &kp SPACE        &kp RET  &kp BSPC  &mo 2  
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans           &kp HOME  &kp END   &kp PGDN  &kp PGUP   &trans  &trans
                &trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans           &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans  &trans
                &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans           &kp INS   &trans    &trans    &trans     &trans  &trans
                                         &trans   &trans   &trans           &trans    &trans    &trans
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &trans   &kp N1  &kp N2  &kp N3  &kp N4  &kp N5             &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
                &trans   &trans  &trans  &trans  &trans  &trans             &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
                &trans   &trans  &trans  &trans  &trans  &trans             &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                                         &trans  &trans  &trans             &trans    &trans    &trans
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &trans   &trans &kp F7  &kp F8  &kp F9 &kp F12   &kp C_VOL_DN  &kp C_MUTE    &kp C_VOL_UP   &trans         &trans        &kp BSPC
                &trans   &trans &kp F4 &kp F5 &kp F6 &kp F11   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4  &bt BT_CLR
                &trans   &trans &kp F1 &kp F2 &kp F3 &kp F10   &trans       &trans      &trans       &trans &trans &studio_unlock
                                   &kp LGUI &mo NAV &kp SPACE   &kp RET &mo 2 &kp RALT
            >;
        };
        extra_1 {
                status = "reserved";
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};